{
  "name": "dwella-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Dwella local macOS trading operations desktop",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {"framer-motion":"^12.42.2","react":"^19.2.0","react-dom":"^19.2.0"},
  "devDependencies": {"@types/node":"^22.15.0","@types/react":"^19.2.0","@types/react-dom":"^19.2.0","@vitejs/plugin-react":"^5.0.0","concurrently":"^9.2.0","electron":"^38.0.0","electron-builder":"^26.0.12","typescript":"^5.9.0","vite":"^7.1.0","wait-on":"^9.0.0"},
  "build": {
    "appId": "com.dwella.desktop",
    "productName": "Dwella",
    "asar": true,
    "files": ["dist/**/*","electron/**/*","package.json"],
    "mac": {"category":"public.app-category.finance","target":["dmg","zip"],"hardenedRuntime":true,"gatekeeperAssess":false},
    "dmg": {"title":"Dwella ${version}"}
  }
}
