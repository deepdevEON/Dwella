{
  "name": "Dwella — Trading Workspace",
  "short_name": "Dwella",
  "description": "A calm trading workspace with TradingView built in.",
  "start_url": "./",
  "scope": "./",
  "display_override": ["fullscreen", "standalone"],
  "display": "fullscreen",
  "orientation": "any",
  "background_color": "#090d0c",
  "theme_color": "#090d0c",
  "icons": [
    {
      "src": "./dwella-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./dwella-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
